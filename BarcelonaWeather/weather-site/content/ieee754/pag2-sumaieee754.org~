** Alineación de exponentes

Para poder sumar dos números IEEE754 ambos deben poseer el mismo
exponente.

#+begin_src python

def alinearExponentes(exp1,mant1,exp2,mant2):

    mant1 = "1" + mant1
    mant2 = "1" + mant2

    while exp1 < exp2:
        mant1 = "0" + mant1[:-1]
        exp1 += 1

    while exp2 < exp1:
        mant2 = "0" + mant2[:-1]
        exp2 += 1

    return exp1, mant1, mant2

#+end_src

Ejemplo.

#+begin_src python

print(
    alinearExponentes(
        1,
        "01000000000000000000000",
        0,
        "01000000000000000000000"
    )
)

#+end_src

